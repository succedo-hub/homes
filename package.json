{
  "name": "aland-homes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@supabase/supabase-js": "2.112.4",
    "astro": "7.2.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "supabase": "2.116.0",
    "typescript": "6.0.3",
    "wrangler": "4.127.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
