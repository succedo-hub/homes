---
import { Image } from 'astro:assets';
import { Building, FileArchive, Landmark, ReceiptText } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyInquiryForm from '../components/CompanyInquiryForm.astro';
import Icon from '../components/Icon.astro';
import kotiBoOverview from '../assets/product/koti-bo-overview.png';
const schema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Digital arbetsyta för bostadsaktiebolag', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'Digital arbetsyta för ekonomi, lägenheter, vederlag, dokument och uppföljning i bostadsaktiebolag på Åland.', url: 'https://homes.ax/koti-bo/' };
---
<BaseLayout title="Digital arbetsyta för bostadsaktiebolag | Homes.ax" description="Samla ekonomi, verifikat, vederlag och dokument i en digital arbetsyta för bostadsaktiebolag. Förenkla administrationen med Homes.ax." schema={schema}>
  <div class="container breadcrumb"><a href="/">Start</a><span aria-hidden="true">/</span><a href="/bolag-forvaltning">Bolag &amp; förvaltning</a><span aria-hidden="true">/</span><span>Digital arbetsyta</span></div>
  <section class="page-hero company-hero"><div class="container"><p class="eyebrow light">Digital administration för bostadsaktiebolag</p><h1>En digital arbetsyta för bostadsaktiebolag på Åland.</h1><p class="lead">Samla ekonomi, vederlag, lägenhetsuppgifter och dokument på ett ställe. Vår digitala arbetsyta gör det enklare att sköta den löpande administrationen och hålla ordning på bolagets information.</p><div class="button-row"><a class="button button-light" href="#kontakt">Boka en genomgång</a><a class="button button-ghost-light" href="https://bo.homes.ax">Öppna arbetsytan</a></div></div></section>

  <section class="section"><div class="container company-product-layout"><div><p class="eyebrow">Administrativ överblick</p><h2>Bolagets administration samlad på ett ställe.</h2><p class="lead">Styrelse och förvaltning ser vad som har hänt, vad som behöver följas upp och var underlaget finns.</p><ul class="check-list"><li>Få bättre överblick över ekonomi och administration</li><li>Följ lägenheter, vederlag och betalningar i samma struktur</li><li>Gör styrelsearbetet enklare att följa upp</li><li>Arbeta på svenska eller finska</li></ul></div><figure class="product-shot product-shot-wide"><Image src={kotiBoOverview} alt="Digital arbetsyta med resultat, bankkonto, verifikat och rapporter" widths={[760, 1200, 1672]} sizes="(max-width: 1000px) 100vw, 58vw" format="webp" quality={88} loading="eager" /><figcaption>Vy från den digitala arbetsytan. Uppgifterna i testbolaget är demonstrationsdata.</figcaption></figure></div></section>

  <section class="section section-soft"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Funktioner</p><h2>Ekonomi, lägenheter, vederlag och dokument.</h2></div><p class="section-aside">Arbetsytan är det digitala verktyget. Bokföring, disponent- och styrelseuppdrag avtalas separat.</p></div><div class="company-services-grid product-capabilities">
    <article><ReceiptText size={50} stroke-width={1.35} /><h3>Ekonomi och verifikat</h3><p>Registrera verifikat, importera kontoutdrag och följ resultat, bankkonto och öppna transaktioner.</p></article>
    <article><Building size={50} stroke-width={1.35} /><h3>Lägenheter och vederlag</h3><p>Samla lägenhetsuppgifter, beräkna vederlag och följ upp betalningar i ett gemensamt flöde.</p></article>
    <article><FileArchive size={50} stroke-width={1.35} /><h3>Dokument</h3><p>Håll bolagets viktiga handlingar tillgängliga där det administrativa arbetet sker.</p></article>
    <article><Landmark size={50} stroke-width={1.35} /><h3>Rapporter och uppföljning</h3><p>Skapa en tydligare lägesbild för styrelsens löpande uppföljning och beslut.</p></article>
  </div></div></section>

  <section class="section company-principle"><div class="container split-copy"><div><p class="eyebrow light">Tjänster för bolaget</p><h2>När bolaget också behöver praktisk hjälp.</h2></div><div class="prose"><p>Den digitala arbetsytan stödjer administrationen. Styrelsen behåller sitt lagstadgade ansvar, och revision eller andra reglerade bedömningar utförs av behöriga aktörer.</p><p>Bokföring, ekonomiadministration, disponentfunktioner och styrelsestöd kan avtalas som separata uppdrag.</p></div></div></section>

  <section class="section section-soft" id="kontakt"><div class="container form-layout"><div><p class="eyebrow">Boka en genomgång</p><h2>Vill ni se hur arbetsytan fungerar?</h2><p class="lead">Berätta kort om bolaget och hur ni arbetar i dag. Vi återkommer för att boka en genomgång.</p><a class="text-link" href="/for-bostadsaktiebolag">Se även tjänster för bostadsaktiebolag <Icon name="arrow" /></a></div><CompanyInquiryForm submitLabel="Boka en genomgång" /></div></section>
</BaseLayout>
