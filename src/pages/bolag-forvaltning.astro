---
import { Building, ChartNoAxesCombined, Laptop, UserRoundCheck } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyInquiryForm from '../components/CompanyInquiryForm.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Bolag och förvaltning på Åland | Homes.ax" description="Ekonomi, bokföring, digitala verktyg och professionellt stöd för mindre bostadsaktiebolag och fastighetsägare på Åland.">
  <div class="container breadcrumb"><a href="/">Start</a><span aria-hidden="true">/</span><span>Bolag &amp; förvaltning</span></div>
  <section class="page-hero company-hero"><div class="container"><p class="eyebrow light">Bolag &amp; förvaltning</p><h1>Förvaltning för mindre bolag på Åland.</h1><p class="lead">Vi hjälper bostadsaktiebolag och fastighetsägande bolag med ekonomi, administration, bokföring, disponentfunktioner, styrelsearbete och digitala verktyg.</p><div class="button-row"><a class="button button-light" href="#inriktningar">Hitta rätt ingång <Icon name="arrow" /></a><a class="button button-ghost-light" href="#kontakt">Beskriv ert behov</a></div></div></section>

  <section class="section" id="inriktningar"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Vem vi hjälper</p><h2>För bostadsaktiebolag och fastighetsägare.</h2></div><p class="section-aside">Digital arbetsyta och löpande tjänsteuppdrag erbjuds var för sig och kan kombineras efter behov.</p></div><div class="business-entry-grid">
    <article><Building size={56} stroke-width={1.35} /><p class="service-kicker">Bostadsaktiebolag</p><h3>Ekonomi, vederlag och styrelsearbete.</h3><p>Digital administration och praktisk hjälp för mindre bostadsaktiebolag som vill samla informationen och minska personberoendet.</p><a class="text-link" href="/for-bostadsaktiebolag">För bostadsaktiebolag <Icon name="arrow" /></a></article>
    <article><ChartNoAxesCombined size={56} stroke-width={1.35} /><p class="service-kicker">Fastighetsägare och uthyrande bolag</p><h3>Ekonomi och administration runt uthyrningen.</h3><p>För bolag som äger eller hyr ut bostäder och lokaler och behöver struktur i ekonomi, dokumentation och löpande administration.</p><a class="text-link" href="/for-fastighetsagare">För fastighetsägare <Icon name="arrow" /></a></article>
  </div></div></section>

  <section class="section section-soft"><div class="container company-product-layout"><div><p class="eyebrow">Digital arbetsyta för bostadsaktiebolag</p><h2>Bolagets administration samlad.</h2><p class="lead">Arbetsytan samlar ekonomi, lägenhetsuppgifter, vederlag, dokument och uppföljning för bostadsaktiebolag på Åland.</p><a class="button" href="/koti-bo">Läs om arbetsytan <Icon name="arrow" /></a></div><div class="value-stack"><article><Laptop size={42} stroke-width={1.4} /><h3>Gemensam arbetsyta</h3><p>En plats för bolagets löpande information och administrativa arbete.</p></article><article><UserRoundCheck size={42} stroke-width={1.4} /><h3>Hjälp i det löpande arbetet</h3><p>Bokföring, administration, styrelsearbete och disponentfunktioner kan avtalas separat.</p></article></div></div></section>

  <section class="section company-principle"><div class="container split-copy"><div><p class="eyebrow light">Personlig kompetens</p><h2>Digitala verktyg med erfarenhet bakom.</h2></div><div class="prose"><p>Homes.ax är utvecklat av konsulterna bakom Sprint Nordic, med erfarenhet av ekonomi, administration, styrelsearbete och digitala arbetsverktyg.</p><p>Den digitala arbetsytan, löpande tjänsteuppdrag och externa specialisttjänster har egna upplägg och villkor.</p></div></div></section>

  <section class="section section-soft" id="kontakt"><div class="container form-layout"><div><p class="eyebrow">Kontakta oss</p><h2>Vilken hjälp behöver bolaget?</h2><p class="lead">Beskriv verksamheten och om behovet gäller ekonomi, administration, digitala verktyg eller ett löpande uppdrag.</p></div><CompanyInquiryForm audience="general" submitLabel="Skicka bolagsförfrågan" /></div></section>
</BaseLayout>
