import BaseLayout from '../../layouts/BaseLayout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import DynamicListings from '../../components/DynamicListings.astro';
---
<BaseLayout title="Bostäder till salu och för uthyrning på Åland | Homes.ax" description="Se aktuella bostadsannonser på Åland. Utforska objekten och ta kontakt med annonsören via bostadens sida.">
  <section class="page-hero container"><p class="eyebrow">Bostäder på Åland</p><h1>Till salu och för uthyrning.</h1><p class="lead">Här ser du aktuella bostadsannonser. Samma bostad kan erbjudas på båda sätten; priserna visas separat och du kontaktar annonsören via objektets sida.</p></section>
  <section class="section section-soft"><div class="container"><div class="listing-toolbar"><p><strong>Publicerade bostäder</strong></p><span class="pill">Åland</span></div><PropertyCard /><DynamicListings /></div></section>
  <section class="section container centered"><h2>Har du en bostad att visa?</h2><p class="lead narrow">Skicka in ett sälj- eller hyresobjekt. Uppgifterna sparas säkert och annonsen granskas innan publicering.</p><a class="button" href="/publicera-annons">Publicera en annons</a></section>
</BaseLayout>
