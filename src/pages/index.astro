---
import { Image } from 'astro:assets';
import { Building, Camera, CircleCheckBig, Handshake, Laptop, MapPin, UserRoundCheck } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import DynamicListings from '../components/DynamicListings.astro';
import Icon from '../components/Icon.astro';
import { property } from '../data/property';
import kotiBoOverview from '../assets/product/koti-bo-overview.png';
import livingRoomCta from '../assets/marketing/living-room-cta.jpg';
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Homes.ax', url: 'https://homes.ax', inLanguage: 'sv-AX', description: 'Bostäder, bolag och boendetjänster på Åland.' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Succedo Invest & Consulting Ab', taxID: '2496398-7', url: 'https://homes.ax', email: 'info@homes.ax', address: { '@type': 'PostalAddress', addressLocality: 'Mariehamn', addressCountry: 'AX' } }
];
---
<BaseLayout title="Bostäder och boendetjänster på Åland | Homes.ax" description="Hitta och annonsera bostäder på Åland. Homes.ax erbjuder också digitala verktyg och tjänster för bostadsaktiebolag och fastighetsägare." schema={schema}>
  <section class="home-hero"><div class="container home-hero-grid">
    <div class="home-hero-copy"><p class="eyebrow light">Homes.ax · Lokalt på Åland</p><h1>Bostäder och boendetjänster på Åland.</h1><p>Hitta bostäder till salu eller för uthyrning, annonsera kostnadsfritt och upptäck digitala verktyg och professionella tjänster för bostäder och fastigheter på Åland.</p><div class="button-row"><a class="button button-light" href="/bostader">Se bostäder <Icon name="arrow" /></a><a class="button button-sage" href="/publicera-annons">Publicera annons <Icon name="arrow" /></a></div><div class="hero-assurances"><span>Kostnadsfria bostadsannonser</span><span>Direktkontakt med annonsören</span><span>Lokalt fokus på Åland</span></div></div>
    <div class="home-hero-visual"><Image src={property.gallery[0].src} alt="Bostadsområde i Västernäs, Mariehamn, fotograferat från luften" widths={[720, 1100, 1500]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={86} loading="eager" fetchpriority="high" /><span class="coordinate">60.0973° N · 19.9346° E</span></div>
  </div></section>

  <section class="local-note"><div class="container"><p><strong>Homes.ax är en digital annonsplattform – inte en fastighetsmäklare.</strong> Annonsör och intressent har direktkontakt och ansvarar själva för en eventuell affär.</p><a class="text-link" href="/om-oss">Så fungerar Homes.ax <Icon name="arrow" /></a></div></section>

  <section class="section section-soft"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Aktuella bostäder</p><h2>Till salu och för uthyrning på Åland.</h2></div><a class="text-link" href="/bostader">Se alla bostäder <Icon name="arrow" /></a></div><PropertyCard /><DynamicListings compact={true} /></div></section>

  <section class="publish-visual-cta" id="publicera"><Image src={livingRoomCta} alt="Ljust minimalistiskt vardagsrum med stora fönster och grön växt" widths={[800, 1300, 2000]} sizes="100vw" format="webp" quality={86} /><div class="container"><div class="publish-visual-card"><p class="eyebrow light">Annonsera din bostad</p><h2>Publicera bostadsannons kostnadsfritt.</h2><p>Beskriv bostaden, lägg till bilder och skicka för granskning. Du har direktkontakt med intressenter. Fotografering, innehåll för sociala medier och riktad annonsering kan väljas separat.</p><a class="button button-light" href="/publicera-annons">Publicera bostadsannons <Icon name="arrow" /></a></div></div></section>

  <section class="section company-intro"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Bolag &amp; förvaltning</p><h2>För bostadsaktiebolag och fastighetsägare.</h2></div><a class="text-link" href="/bolag-forvaltning">Se hela erbjudandet <Icon name="arrow" /></a></div><p class="lead company-lead">Vi hjälper mindre bostadsaktiebolag och fastighetsägande bolag med digital administration, ekonomi, bokföring, disponentfunktioner och styrelsearbete.</p><div class="business-entry-grid home-business-grid">
    <article><Building size={54} stroke-width={1.35} /><p class="service-kicker">För bostadsaktiebolag</p><h3>Administration och ekonomi i bolaget.</h3><p>Digital arbetsyta, ekonomiadministration, disponentfunktioner och stöd i styrelsearbetet.</p><a class="text-link" href="/for-bostadsaktiebolag">För bostadsaktiebolag <Icon name="arrow" /></a></article>
    <article><UserRoundCheck size={54} stroke-width={1.35} /><p class="service-kicker">För fastighetsägare</p><h3>Struktur runt ekonomi och uthyrning.</h3><p>Praktiskt stöd för mindre bolag som äger eller hyr ut bostäder och lokaler.</p><a class="text-link" href="/for-fastighetsagare">För fastighetsägare <Icon name="arrow" /></a></article>
  </div></div></section>

  <section class="section section-soft"><div class="container company-product-layout"><div><p class="eyebrow">Digital arbetsyta för bostadsaktiebolag</p><h2>Ekonomi, vederlag och dokument på ett ställe.</h2><p class="lead">Den digitala arbetsytan samlar bolagets ekonomi, lägenhetsuppgifter, vederlag, dokument och rapporter.</p><a class="button" href="/koti-bo">Läs om arbetsytan <Icon name="arrow" /></a></div><figure class="product-shot product-shot-wide"><Image src={kotiBoOverview} alt="Digital arbetsyta med översikt över ekonomi, bankkonto, verifikat och rapporter" widths={[720, 1100, 1500]} sizes="(max-width: 1100px) 100vw, 55vw" format="webp" quality={86} /><figcaption>Vy från den digitala arbetsytan. Uppgifterna är demonstrationsdata.</figcaption></figure></div></section>

  <section class="section service-overview"><div class="container"><div class="intro-grid"><div><p class="eyebrow">Tjänster kring bostaden</p><h2>Tjänster för bostäder och bolag.</h2></div><div><p class="lead">Fotografering och marknadsföring, ekonomi och administration, disponent- och styrelseuppdrag samt juridiska och praktiska tjänster via ansvariga samarbetspartner.</p><a class="text-link" href="/tjanster">Utforska våra tjänster <Icon name="arrow" /></a></div></div><div class="service-icon-row">
    <a href="/tjanster#forsaljning"><Camera size={50} stroke-width={1.4} /><span>Fotografering &amp; marknadsföring</span></a>
    <a href="/tjanster#bolag"><Laptop size={50} stroke-width={1.4} /><span>Ekonomi &amp; administration</span></a>
    <a href="/tjanster#bolag"><Building size={50} stroke-width={1.4} /><span>Disponent &amp; styrelse</span></a>
    <a href="/tjanster#bostadsaffaren"><Handshake size={50} stroke-width={1.4} /><span>Specialister &amp; partners</span></a>
  </div></div></section>

  <section class="section why-section"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Varför Homes.ax?</p><h2>En lokal tjänst med praktiska kontaktvägar.</h2></div></div><div class="why-grid">
    <article><MapPin size={38} stroke-width={1.45} /><h3>Åländsk förankring</h3><p>En lokal plattform byggd för bostäder, bolag och fastigheter på Åland.</p></article>
    <article><CircleCheckBig size={38} stroke-width={1.45} /><h3>Tydliga roller</h3><p>Du ser vem som publicerar, vem som utför tjänsten och vem som är avtalspart.</p></article>
    <article><Laptop size={38} stroke-width={1.45} /><h3>Digitala arbetssätt</h3><p>Snabba annonser, tydliga kontaktvägar och verktyg som minskar dubbelarbete.</p></article>
    <article><UserRoundCheck size={38} stroke-width={1.45} /><h3>Personlig kompetens</h3><p>Professionellt stöd kan kombineras efter verkligt behov och avtalas separat.</p></article>
  </div></div></section>

  <section class="section partner-band"><div class="container contact-journeys"><div><p class="eyebrow light">Kontakt &amp; samarbete</p><h2>Kontakta rätt person från början.</h2><p>Bostadsfrågor går direkt till annonsören. Bolag, tjänsteleverantörer och samarbetspartner har egna kontaktvägar.</p></div><div class="journey-links"><a href="/bostader">Jag söker bostad <Icon name="arrow" /></a><a href="/publicera-annons">Jag vill annonsera <Icon name="arrow" /></a><a href="/bolag-forvaltning#kontakt">Vi representerar ett bolag <Icon name="arrow" /></a><a href="/samarbeta">Vi vill samarbeta <Icon name="arrow" /></a></div></div></section>
</BaseLayout>
