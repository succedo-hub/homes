---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import DynamicListings from '../components/DynamicListings.astro';
import Icon from '../components/Icon.astro';
import { property } from '../data/property';
const schema = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: 'Homes.ax', url: 'https://homes.ax',
  description: 'Digital annonsplattform för bostäder på Åland.'
};
---
<BaseLayout title="Homes.ax" description="Hitta bostäder till salu och för uthyrning på Åland eller skicka in din egen annons för granskning." schema={schema}>
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow light">Hem och bostäder på Åland</p>
        <h1>Hitta hem.<br />Skapa synlighet.</h1>
        <p>Bostäder till salu och för uthyrning, samlade på ett ställe.</p>
        <div class="button-row"><a class="button button-light" href="/bostader">Utforska bostäder <Icon name="arrow" /></a><a class="button button-ghost-light" href="/publicera-annons">Publicera annons</a></div>
        <div class="hero-assurances"><span>✓ Granskade annonser</span><span>⌖ Lokalt på Åland</span><span>♡ Direktkontakt</span></div>
      </div>
      <div class="home-hero-visual">
        <Image src={property.gallery[0].src} alt="Bostadsområde i Västernäs, Mariehamn, fotograferat från luften" widths={[720, 1100, 1500]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={86} loading="eager" fetchpriority="high" />
        <span class="coordinate">60.0973° N · 19.9346° E</span>
      </div>
    </div>
  </section>

  <section class="service-ribbon">
    <div class="container service-ribbon-grid">
      <article><span>▱</span><h2>Fotografering</h2><p>Professionella bilder som lyfter fram ditt hem.</p></article>
      <article><span>◫</span><h2>Marknadsföring</h2><p>Tydlig presentation och rätt kanaler.</p></article>
      <article><span>⌂</span><h2>Energideklaration</h2><p>Kommande stöd genom utvalda partners.</p></article>
      <article><span>✎</span><h2>Köpvittne</h2><p>Information om oberoende hjälp vid en trygg affär.</p></article>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading-row"><div><p class="eyebrow">Aktuellt</p><h2>Utvalda bostäder på Åland</h2></div><a class="text-link" href="/bostader">Se alla bostäder <Icon name="arrow" /></a></div>
      <PropertyCard />
      <DynamicListings compact={true} />
    </div>
  </section>

  <section class="section cta-split">
    <div class="container cta-split-inner"><div><p class="eyebrow">Redo att publicera?</p><h2>Låt ditt objekt få en tydlig plats.</h2><p>Skicka in uppgifterna kostnadsfritt. Annonsen granskas innan den blir synlig.</p></div><a class="button" href="/publicera-annons">Publicera annons <Icon name="arrow" /></a></div>
  </section>
</BaseLayout>
