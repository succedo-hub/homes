---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import DynamicListings from '../components/DynamicListings.astro';
import Icon from '../components/Icon.astro';
import { property } from '../data/property';
import kotiBoOverview from '../assets/product/koti-bo-overview.png';
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Homes.ax', url: 'https://homes.ax', description: 'Bostäder och digitala tjänster för boende på Åland.' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Succedo Invest & Consulting Ab', taxID: '2496398-7', url: 'https://homes.ax', email: 'info@homes.ax', address: { '@type': 'PostalAddress', addressLocality: 'Mariehamn', addressCountry: 'AX' } }
];
---
<BaseLayout title="Homes.ax | Bostäder och bostadsaktiebolag på Åland" description="Hitta bostäder, publicera en annons och få bättre kontroll i bostadsaktiebolaget med Koti/bo och ett erfaret lokalt tjänstenätverk." schema={schema}>
  <section class="home-hero"><div class="container home-hero-grid">
    <div class="home-hero-copy"><p class="eyebrow light">Bostäder och smartare bolagsvardag</p><h1>Hem på Åland.<br />Skött smartare.</h1><p>Hitta bostad, ge ditt objekt rätt synlighet eller samla bostadsaktiebolagets ekonomi, dokument och förvaltning i ett tydligare flöde.</p><div class="button-row"><a class="button button-light" href="/bostader">Se bostäder <Icon name="arrow" /></a><a class="button button-sage" href="/for-bostadsaktiebolag">Tjänster för bostadsaktiebolag <Icon name="arrow" /></a><a class="hero-text-link" href="/publicera-annons">Publicera annons</a></div><div class="hero-assurances"><span>Lokalt på Åland</span><span>Digitalt stöd för bolaget</span><span>Erfarna tjänstepartners</span></div></div>
    <div class="home-hero-visual"><Image src={property.gallery[0].src} alt="Bostadsområde i Västernäs, Mariehamn, fotograferat från luften" widths={[720, 1100, 1500]} sizes="(max-width: 900px) 100vw, 50vw" format="webp" quality={86} loading="eager" fetchpriority="high" /><span class="coordinate">60.0973° N · 19.9346° E</span></div>
  </div></section>
  <section class="local-note"><div class="container"><p>En åländsk plattform för bostadsannonser, bostadsaktiebolag och tjänsterna som får boendet att fungera.</p><a class="text-link" href="/om-oss">Så fungerar Homes.ax <Icon name="arrow" /></a></div></section>
  <section class="section section-soft"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Aktuellt</p><h2>En bostad med två möjligheter</h2></div><a class="text-link" href="/bostader">Se alla bostäder <Icon name="arrow" /></a></div><PropertyCard /><DynamicListings compact={true} /></div></section>
  <section class="section company-intro"><div class="container company-intro-grid">
    <div><p class="eyebrow">Koti/bo för bostadsaktiebolag</p><h2>Bolagets arbete. Samlat och under kontroll.</h2><p class="lead">Koti/bo samlar bank, verifikat, lägenheter, vederlag, rapporter och dokument i en och samma arbetsyta. När ni behöver mer än programvara finns vårt erfarna nätverk för styrelsearbete, disponent-, administrations- och bokföringstjänster.</p><a class="button" href="/for-bostadsaktiebolag">Se tjänster för bostadsaktiebolag <Icon name="arrow" /></a></div>
    <figure class="product-shot"><Image src={kotiBoOverview} alt="Koti/bo – digital översikt för ett bostadsaktiebolag med ekonomi, bank, verifikat och rapporter" widths={[720, 1100, 1500]} sizes="(max-width: 1100px) 100vw, 55vw" format="webp" quality={86} /><figcaption>Koti/bo ger styrelsen och förvaltningen en gemensam lägesbild.</figcaption></figure>
  </div></section>
  <section class="section service-overview"><div class="container"><div class="intro-grid"><div><p class="eyebrow">Tjänster kring boendet</p><h2>Rätt kompetens. Utan omvägar.</h2></div><div><p class="lead">Städning, fotografering, offentligt köpvittne och energideklarationer – via lokala samarbetspartners som ansvarar för sina uppdrag och villkor.</p><a class="text-link" href="/tjanster">Utforska tjänsterna <Icon name="arrow" /></a></div></div></div></section>
  <section class="section partner-band"><div class="container partner-band-inner"><div><p class="eyebrow light">Samarbeta med oss</p><h2>Har ni kompetensen? Vi bygger räckvidden.</h2><p>Homes.ax växer med erfarna aktörer inom bostadsaktiebolag, fastighetsaffärer och tjänster kring boendet. Vi söker fler samarbeten där roller, ansvar och kundnytta är glasklara.</p></div><a class="button button-light" href="/samarbeta">Föreslå ett samarbete <Icon name="arrow" /></a></div></section>
  <section class="section cta-split"><div class="container cta-split-inner"><div><p class="eyebrow">Har du en bostad att visa?</p><h2>Ge den en tydlig plats.</h2><p>Skicka in uppgifterna kostnadsfritt. Annonsen innehållsgranskas före publicering.</p></div><a class="button" href="/publicera-annons">Publicera annons <Icon name="arrow" /></a></div></section>
</BaseLayout>
