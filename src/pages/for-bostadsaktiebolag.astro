---
import { Image } from 'astro:assets';
import { BookOpenCheck, BriefcaseBusiness, NotebookTabs, ReceiptText } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyInquiryForm from '../components/CompanyInquiryForm.astro';
import kotiBoOverview from '../assets/product/koti-bo-overview.png';
---
<BaseLayout title="Bostadsaktiebolag på Åland – Ekonomi och förvaltning | Homes.ax" description="Digital arbetsyta, bokföring, administration och disponenttjänster för bostadsaktiebolag på Åland. Läs mer om hur Homes.ax kan hjälpa ert bolag.">
  <div class="container breadcrumb"><a href="/">Start</a><span aria-hidden="true">/</span><a href="/bolag-forvaltning">Bolag &amp; förvaltning</a><span aria-hidden="true">/</span><span>Bostadsaktiebolag</span></div>
  <section class="page-hero company-hero"><div class="container"><p class="eyebrow light">För bostadsaktiebolag</p><h1>Hjälp för bostadsaktiebolag på Åland.</h1><p class="lead">Vi hjälper mindre bostadsaktiebolag i Mariehamn och på övriga Åland med digital administration, bokföring, disponentfunktioner och styrelsearbete.</p><div class="button-row"><a class="button button-light" href="#kontakt">Boka en första genomgång</a><a class="button button-ghost-light" href="/koti-bo">Se den digitala arbetsytan</a></div></div></section>

  <section class="section" id="koti-bo"><div class="container company-product-layout">
    <div><p class="eyebrow">Den digitala arbetsytan</p><h2>En digital arbetsyta för styrelsen.</h2><p class="lead">Ekonomi, verifikat, lägenhetsuppgifter, vederlag, rapporter och dokument samlas på ett ställe. Styrelsen får en gemensam överblick och slipper hålla samma information i flera parallella filer.</p><ul class="check-list"><li>Ekonomi och verifikat i ett sammanhållet flöde</li><li>Lägenheter, vederlag och uppföljning nära varandra</li><li>Rapporter och dokument där arbetet faktiskt sker</li><li>Svenskt och finskt gränssnitt</li></ul></div>
    <figure class="product-shot product-shot-wide"><Image src={kotiBoOverview} alt="Digital arbetsyta med ekonomi, bankkonto, verifikat och rapporter för ett bostadsaktiebolag" widths={[760, 1200, 1672]} sizes="(max-width: 1000px) 100vw, 58vw" format="webp" quality={88} loading="eager" /><figcaption>Vy från den digitala arbetsytan. Uppgifterna i testbolaget är demonstrationsdata.</figcaption></figure>
  </div></section>

  <section class="section section-soft"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Arbetsytan i praktiken</p><h2>Ekonomi, vederlag och dokument.</h2></div><p class="section-aside">Funktionerna stödjer det löpande arbetet i mindre bostadsaktiebolag.</p></div><div class="module-grid">
    <article><span>01</span><h3>Ekonomi och bokföringsunderlag</h3><p>Registrera verifikat, importera kontoutdrag och få en snabb bild av resultat, bankkonto och öppna transaktioner.</p></article>
    <article><span>02</span><h3>Lägenheter och vederlag</h3><p>Samla lägenhetsuppgifter, beräkna vederlag och följ upp betalningar med samma struktur genom hela bolaget.</p></article>
    <article><span>03</span><h3>Rapporter och dokument</h3><p>Håll rapporter, beslut och viktiga handlingar tillgängliga för rätt personer utan att tappa bort sammanhanget.</p></article>
  </div></div></section>

  <section class="section"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Tjänster för bolaget</p><h2>Bokföring, administration och stöd i styrelsearbetet.</h2></div><p class="section-aside">Behöver styrelsen hjälp med det löpande arbetet kan tjänster avtalas utifrån bolagets behov.</p></div><div class="company-services-grid">
    <article><BookOpenCheck size={52} stroke-width={1.4} /><span>01</span><h3>Styrelsearbete</h3><p>Struktur, årshjul, mötesarbete och uppföljning som hjälper styrelsen att fatta beslut med bättre underlag.</p></article>
    <article><BriefcaseBusiness size={52} stroke-width={1.4} /><span>02</span><h3>Disponenttjänster</h3><p>Praktisk koordinering och löpande stöd anpassat efter bolagets storlek, ansvar och faktiska behov.</p></article>
    <article><NotebookTabs size={52} stroke-width={1.4} /><span>03</span><h3>Administration</h3><p>Ordning på boendeinformation, dokument, återkommande uppgifter och den vardag som annars lätt blir personberoende.</p></article>
    <article><ReceiptText size={52} stroke-width={1.4} /><span>04</span><h3>Bokföring</h3><p>Löpande bokföring och ekonomisk uppföljning erbjuds som ett separat uppdrag för bolaget.</p></article>
  </div></div></section>

  <section class="section company-principle"><div class="container split-copy"><div><p class="eyebrow light">Ansvar och uppdrag</p><h2>Så fördelas arbetet.</h2></div><div class="prose"><p>Den digitala arbetsytan stödjer administrationen, medan styrelsen behåller sitt lagstadgade ansvar. Revision och andra reglerade bedömningar utförs av behöriga aktörer.</p><p>För varje tjänsteuppdrag anges vem som utför arbetet, vilken avtalspart som gäller och vad uppdraget omfattar.</p></div></div></section>

  <section class="section section-soft" id="kontakt"><div class="container form-layout"><div><p class="eyebrow">Kontakta oss</p><h2>Vad behöver styrelsen hjälp med?</h2><p class="lead">Berätta kort om bolaget och om ni söker en digital arbetsyta, bokföring, administration, disponenttjänster eller stöd i styrelsearbetet.</p></div><CompanyInquiryForm /></div></section>
</BaseLayout>
