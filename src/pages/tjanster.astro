---
import { BookOpenCheck, BriefcaseBusiness, Building, Camera, FileCheck, FileText, Megaphone, MonitorSmartphone, NotebookTabs, Scale, Sparkles } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Bostads- och fastighetstjänster på Åland | Homes.ax" description="Fotografering, marknadsföring, ekonomiadministration, disponenttjänster, offentligt köpvittne, energideklaration och flyttstädning på Åland.">
  <div class="container breadcrumb"><a href="/">Start</a><span aria-hidden="true">/</span><span>Tjänster</span></div>
  <section class="page-hero container"><p class="eyebrow">Tjänster kring bostäder och fastigheter</p><h1>Rätt hjälp. Tydligt ansvar. På Åland.</h1><p class="lead">Här samlas tjänster för bostadsannonser, bolagsvardag, bostadsaffärer och flytt. Du ser om tjänsten erbjuds som digital produkt, professionellt uppdrag eller genom en ansvarig samarbetspartner.</p></section>

  <nav class="service-category-nav container" aria-label="Tjänstekategorier"><a href="#forsaljning">Försäljning &amp; uthyrning</a><a href="#bolag">Bostads- &amp; fastighetsbolag</a><a href="#bostadsaffaren">Vid bostadsaffären</a><a href="#flytt">Flytt &amp; inflyttning</a></nav>

  <section class="section section-soft service-category" id="forsaljning"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Inför försäljning och uthyrning</p><h2>En tydligare presentation. Större relevant räckvidd.</h2></div><p class="section-aside">Bostadsannonsen är kostnadsfri. Foto- och marknadsföringstjänster beställs separat.</p></div><div class="catalog-grid">
    <article><Camera size={52} stroke-width={1.35} /><p class="service-kicker">Professionell tjänst</p><h3>Bostadsfotografering</h3><p>Bilder som presenterar planlösning, ljus och bostadens viktigaste kvaliteter för försäljning eller uthyrning.</p><dl><div><dt>Kundgrupp</dt><dd>Privata och professionella annonsörer</dd></div><div><dt>Utförare</dt><dd>Ansvarig samarbetspartner</dd></div><div><dt>Status</dt><dd>Tillgänglig efter överenskommelse</dd></div></dl><a class="text-link" href="mailto:info@homes.ax?subject=Bostadsfotografering">Fråga om fotografering <Icon name="arrow" /></a></article>
    <article><Megaphone size={52} stroke-width={1.35} /><p class="service-kicker">Separat marknadsföringsupplägg</p><h3>Bostadsmarknadsföring</h3><p>Innehåll för sociala medier och riktad annonsering som leder tillbaka till en tydlig objektsida på Homes.ax.</p><dl><div><dt>Kundgrupp</dt><dd>Bostadsannonsörer</dd></div><div><dt>Utförare</dt><dd>Homes.ax och ansvariga konsulter</dd></div><div><dt>Status</dt><dd>Tillgänglig enligt offert</dd></div></dl><a class="text-link" href="mailto:info@homes.ax?subject=Marknadsföring%20av%20bostad">Fråga om marknadsföring <Icon name="arrow" /></a></article>
    <article><MonitorSmartphone size={52} stroke-width={1.35} /><p class="service-kicker">Digital plattform</p><h3>Professionell bostadspresentation</h3><p>Strukturerad objektsida med bilder, fakta, pris och direkt kontakt mellan annonsör och intressent.</p><dl><div><dt>Kundgrupp</dt><dd>Bostadsannonsörer</dd></div><div><dt>Leverantör</dt><dd>Homes.ax</dd></div><div><dt>Status</dt><dd>Kostnadsfri publicering efter granskning</dd></div></dl><a class="text-link" href="/publicera-annons">Publicera bostadsannons <Icon name="arrow" /></a></article>
  </div></div></section>

  <section class="section service-category" id="bolag"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">För bostads- och fastighetsbolag</p><h2>Digitala verktyg och professionell kompetens.</h2></div><a class="text-link" href="/bolag-forvaltning">Bolag &amp; förvaltning <Icon name="arrow" /></a></div><div class="catalog-grid catalog-grid-five">
    <article><BookOpenCheck size={48} stroke-width={1.35} /><p class="service-kicker">Professionellt uppdrag</p><h3>Bokföring</h3><p>Löpande ekonomitjänster och uppföljning efter bolagets omfattning och behov.</p><dl><div><dt>Utförare</dt><dd>Anges i separat avtal</dd></div><div><dt>Status</dt><dd>Förfrågan bedöms individuellt</dd></div></dl><a class="text-link" href="/bolag-forvaltning#kontakt">Beskriv behovet</a></article>
    <article><NotebookTabs size={48} stroke-width={1.35} /><p class="service-kicker">Professionellt uppdrag</p><h3>Ekonomiadministration</h3><p>Struktur för underlag, återkommande flöden, uppföljning och bolagets administrativa vardag.</p><dl><div><dt>Utförare</dt><dd>Anges i separat avtal</dd></div><div><dt>Status</dt><dd>Förfrågan bedöms individuellt</dd></div></dl><a class="text-link" href="/bolag-forvaltning#kontakt">Beskriv behovet</a></article>
    <article><BriefcaseBusiness size={48} stroke-width={1.35} /><p class="service-kicker">Professionellt uppdrag</p><h3>Disponentfunktioner</h3><p>Praktisk koordinering och löpande stöd anpassat efter bolagets storlek och ansvar.</p><dl><div><dt>Utförare</dt><dd>Anges i separat avtal</dd></div><div><dt>Status</dt><dd>Förfrågan bedöms individuellt</dd></div></dl><a class="text-link" href="/for-bostadsaktiebolag#kontakt">Kontakta oss</a></article>
    <article><Building size={48} stroke-width={1.35} /><p class="service-kicker">Professionellt uppdrag</p><h3>Styrelseuppdrag</h3><p>Struktur, mötesarbete och uppföljning för beslut med bättre underlag.</p><dl><div><dt>Utförare</dt><dd>Anges i separat avtal</dd></div><div><dt>Status</dt><dd>Förfrågan bedöms individuellt</dd></div></dl><a class="text-link" href="/for-bostadsaktiebolag#kontakt">Kontakta oss</a></article>
    <article><MonitorSmartphone size={48} stroke-width={1.35} /><p class="service-kicker">Digital produkt</p><h3>Koti/bo</h3><p>Arbetsyta för ekonomi, lägenheter, vederlag, dokument och uppföljning i bostadsaktiebolag.</p><dl><div><dt>Leverantör</dt><dd>Succedo / Homes.ax</dd></div><div><dt>Status</dt><dd>Tillgänglig produkt</dd></div></dl><a class="text-link" href="/koti-bo">Utforska Koti/bo</a></article>
  </div></div></section>

  <section class="section section-soft service-category" id="bostadsaffaren"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Vid bostadsaffären</p><h2>Specialister när uppdraget kräver det.</h2></div><p class="section-aside">Varje extern leverantör ansvarar för sin bedömning, sitt pris, sitt avtal och sina villkor.</p></div><div class="catalog-grid">
    <article><Scale size={52} stroke-width={1.35} /><p class="service-kicker">Via ansvarig partner</p><h3>Offentligt köpvittne</h3><p>Kontakt med offentligt köpvittne för fastighetsöverlåtelser där köpvittne krävs.</p><dl><div><dt>Status</dt><dd>Tillgänglig efter överenskommelse</dd></div><div><dt>Ansvar</dt><dd>Utsedd tjänsteleverantör</dd></div></dl><a class="text-link" href="mailto:info@homes.ax?subject=Offentligt%20köpvittne">Be om kontakt</a></article>
    <article><FileText size={52} stroke-width={1.35} /><p class="service-kicker">Specialistförfrågan</p><h3>Juridisk konsultation</h3><p>Förfrågningar som kräver juridisk rådgivning bedöms och kan hänvisas till en ansvarig, behörig aktör.</p><dl><div><dt>Status</dt><dd>Verifieras för varje förfrågan</dd></div><div><dt>Ansvar</dt><dd>Avtalad specialist</dd></div></dl><a class="text-link" href="mailto:info@homes.ax?subject=Juridisk%20konsultation">Beskriv frågan</a></article>
    <article><FileCheck size={52} stroke-width={1.35} /><p class="service-kicker">Via ansvarig partner</p><h3>Energideklaration</h3><p>Hjälp av sakkunnig aktör när en bostad eller fastighet behöver energideklareras.</p><dl><div><dt>Status</dt><dd>Tillgänglig efter överenskommelse</dd></div><div><dt>Ansvar</dt><dd>Utsedd sakkunnig</dd></div></dl><a class="text-link" href="mailto:info@homes.ax?subject=Energideklaration">Be om kontakt</a></article>
  </div></div></section>

  <section class="section service-category" id="flytt"><div class="container"><div class="section-heading-row"><div><p class="eyebrow">Vid flytt och inflyttning</p><h2>Praktisk hjälp när bostaden byter händer.</h2></div></div><div class="catalog-grid catalog-grid-single">
    <article><Sparkles size={52} stroke-width={1.35} /><p class="service-kicker">Via ansvarig partner</p><h3>Flyttstädning</h3><p>Städning inför utflyttning, inflyttning, fotografering eller visning. Omfattning och bokning avtalas direkt med utföraren.</p><dl><div><dt>Kundgrupp</dt><dd>Privatpersoner och fastighetsägare</dd></div><div><dt>Status</dt><dd>Tillgänglig efter överenskommelse</dd></div><div><dt>Ansvar</dt><dd>Utsedd städpartner</dd></div></dl><a class="text-link" href="mailto:info@homes.ax?subject=Flyttstädning">Be om kontakt <Icon name="arrow" /></a></article>
  </div><div class="service-principle"><p><strong>Homes.ax bedriver inte fastighetsmäklarverksamhet.</strong> Bostadsannonser publiceras kostnadsfritt och parterna har direktkontakt. Digitala produkter, professionella uppdrag och partnerutförda tjänster är separata erbjudanden med egna avtal och villkor.</p></div></div></section>

  <section class="section container centered"><p class="eyebrow">Fler starka aktörer får gärna kliva fram</p><h2>Erbjuder ni en relevant tjänst?</h2><p class="lead narrow">Vi söker fler samarbeten som gör boendet enklare och kundnyttan tydligare. Ni står för sakkunskapen och uppdraget. Homes.ax står för en modern digital väg till kunden.</p><a class="button" href="/samarbeta">Läs om samarbete</a></section>
</BaseLayout>
