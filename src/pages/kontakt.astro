---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Kontakt" description="Kontakta Homes.ax om bostadsannonser, bostadstjänster eller frågor om plattformen.">
  <section class="page-hero container"><p class="eyebrow">Kontakt</p><h1>Vi hjälper dig vidare</h1><p class="lead">Vill du publicera en bostad, synas med en tjänst eller ställa en fråga? Skicka ett mejl så återkommer vi.</p></section>
  <section class="section section-soft"><div class="container contact-grid"><div><p class="eyebrow">E-post</p><h2><a href="mailto:info@homes.ax">info@homes.ax</a></h2><p>Beskriv gärna vad ditt ärende gäller och lämna de uppgifter som behövs för att vi ska kunna svara.</p></div><div class="contact-actions"><a class="button full" href="mailto:info@homes.ax?subject=Jag%20vill%20publicera%20en%20bostadsannons">Publicera bostadsannons <Icon name="mail" /></a><a class="button button-secondary full" href="mailto:info@homes.ax?subject=Fråga%20till%20Åland%20Homes">Ställ en fråga</a></div></div></section>
</BaseLayout>
