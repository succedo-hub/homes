---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout title="Jag söker bostad" description="Berätta vilket boende du söker på Åland och lämna dina kontaktuppgifter till Åland Homes.">
  <section class="page-hero container"><p class="eyebrow">Jag söker bostad</p><h1>Berätta vad du letar efter</h1><p class="lead">Lämna dina kontaktuppgifter och beskriv bostaden du söker. Vi sparar din förfrågan och kan kontakta dig om relevant information blir tillgänglig.</p></section>
  <section class="section section-soft">
    <div class="container form-layout">
      <div><p class="eyebrow">Bostadsförfrågan</p><h2>Vi vill förstå dina behov</h2><p>Ju tydligare du beskriver område, storlek, tidpunkt och budget, desto lättare är det att förstå vad du söker. Formuläret är inte en köplats eller garanti om erbjudande.</p></div>
      <ContactForm subject="Ny bostadsförfrågan via Åland Homes" context="bostadssökande" submitLabel="Skicka bostadsförfrågan" showPreferences={true} />
    </div>
  </section>
</BaseLayout>
