---
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const links = [
  ['/bostader', 'Bostäder'], ['/publicera-annons', 'Publicera annons'], ['/bolag-forvaltning', 'Bolag & förvaltning'], ['/tjanster', 'Tjänster'], ['/om-oss', 'Om Homes.ax']
] as const;
---
<header class="site-header">
  <a class="skip-link" href="#main">Hoppa till innehållet</a>
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="Homes.ax – startsida">
      <img src="/brand/homes-ax-icon-light.svg" alt="" width="46" height="36" />
      <span>Homes.ax</span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="nav"><Icon name="menu" /> <span>Meny</span></button>
    <nav id="nav" aria-label="Huvudmeny">
      {links.map(([href, label]) => <a class:list={{ 'nav-featured': href === '/publicera-annons' }} href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('#nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
</script>
