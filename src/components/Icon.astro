---
interface Props { name: 'arrow' | 'mail' | 'home' | 'area' | 'rooms' | 'calendar' | 'close' | 'menu'; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="m5 12 14 0m-6-6 6 6-6 6" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'home' && <path d="m3 11 9-8 9 8v9a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" />}
  {name === 'area' && <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />}
  {name === 'rooms' && <path d="M3 5h18v14H3zM12 5v14M3 12h9" />}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></>}
  {name === 'close' && <path d="m6 6 12 12M18 6 6 18" />}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
</svg>
